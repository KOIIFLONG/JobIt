// Database schema for JobIt user authentication and job favorites

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model with robust authentication and profile details
model User {
  // UUID-based auto-generated ID
  id            String    @id @default(uuid())
  
  // Unique email with explicit unique constraint
  email         String    @unique
  
  // Password will be stored as hashed value (enforced in application logic)
  password      String
  
  // Optional profile details
  username      String?   
  firstName     String?
  lastName      String?
  
  // Automatic timestamp for creation
  createdAt     DateTime  @default(now())
  
  // Additional metadata
  lastLogin     DateTime?
  emailVerified Boolean   @default(false)
  
  // Relationships and additional fields
  savedJobs     SavedJob[]
  
  // Optional profile information
  profileImage  String?
  location      String?
  bio           String?
  skills        String[]
}

// Model to track user's saved job postings
model SavedJob {
  id            String    @id @default(uuid())
  userId        String
  jobId         String    // External job identifier
  jobTitle      String
  companyName   String
  savedAt       DateTime  @default(now())
  
  // Relationship to User with cascading delete
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Ensure unique combination of user and job
  @@unique([userId, jobId])
}