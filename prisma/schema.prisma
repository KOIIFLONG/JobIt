datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  passwordHash  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  savedJobs     SavedJob[]
  
  @@index([email])
}

model SavedJob {
  id            String      @id @default(cuid())
  userId        String
  jobId         String
  jobTitle      String
  companyName   String
  savedAt       DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, jobId])
}