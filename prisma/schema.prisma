// Database Configuration for User Authentication
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User Model with Comprehensive Authentication Fields
model User {
  // Auto-incrementing integer ID with explicit configuration
  id             Int         @id @default(autoincrement())
  
  // Email with explicit unique constraint
  email          String      @unique
  
  // Securely hashed password field
  password       String
  
  // Automatic timestamp tracking
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  // Additional user metadata
  name           String?
  profileImage   String?
  lastLogin      DateTime?
  
  // User authorization and job interaction
  role           UserRole    @default(USER)
  savedJobs      SavedJob[]
}

// Saved Job Tracking Model
model SavedJob {
  id            Int      @id @default(autoincrement())
  userId        Int
  jobId         String   
  jobTitle      String
  companyName   String
  savedAt       DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Ensure unique saved job for a user
  @@unique([userId, jobId])
}

// User Role Enumeration
enum UserRole {
  USER
  ADMIN
  EMPLOYER
}