// Database schema for user authentication and job favorites

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model with authentication and job favorites
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  profileImage  String?
  
  // Authentication and security fields
  emailVerified DateTime?
  lastLogin     DateTime?
  
  // Job favorites and interactions
  savedJobs     SavedJob[]
  
  // Audit and tracking
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Saved Jobs model to track user's favorite job postings
model SavedJob {
  id            String    @id @default(cuid())
  userId        String
  jobId         String
  jobTitle      String
  companyName   String
  savedAt       DateTime  @default(now())
  
  // Relationship to User
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Ensure unique combination of user and job
  @@unique([userId, jobId])
}