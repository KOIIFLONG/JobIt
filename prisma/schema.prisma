// User Authentication and Job Favorites Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model with secure authentication and profile management
model User {
  // UUID-based unique identifier
  id             String      @id @default(uuid())
  
  // Email with unique constraint to prevent duplicate registrations
  email          String      @unique
  
  // Hashed password for security
  password       String
  
  // Profile information
  name           String?
  profileImage   String?
  
  // Automatic timestamp management
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  // Additional user metadata
  lastLogin      DateTime?
  isActive       Boolean     @default(true)
  
  // User authorization and job interaction
  role           UserRole    @default(USER)
  savedJobs      SavedJob[]
}

// Saved Job model to track user's favorite job postings
model SavedJob {
  id            String   @id @default(uuid())
  userId        String
  jobId         String   // External job identifier
  jobTitle      String
  companyName   String
  savedAt       DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Ensure unique saved job for a user
  @@unique([userId, jobId])
}

// User role enumeration for authorization
enum UserRole {
  USER
  ADMIN
  EMPLOYER
}